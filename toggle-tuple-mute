#!/usr/bin/env python3
"""
Toggle Tuple mute status via global keybinding.

The Tuple CLI can't report whether you're muted, so this asks the running
Tuple UI (which tracks mute state) to toggle it by sending it a signal.
"""

import os
import signal
import subprocess
import sys
from pathlib import Path

# Keep in sync with TOGGLE_MUTE_SIGNAL in tuple_ui.py.
TOGGLE_MUTE_SIGNAL = signal.SIGRTMIN + 1
# Dev launch (`python3 tuple_ui.py`) or installed console script.
TUPLE_UI_PATTERN = r"python.*(tuple_ui\.py|bin/tuple-ui)"
LOG_PATH = Path.home() / ".toggle-tuple-mute.log"


def log(message):
    try:
        with open(LOG_PATH, "a") as f:
            f.write(f"{message}\n")
    except OSError:
        pass


def find_tuple_ui_pid():
    result = subprocess.run(
        ["pgrep", "-f", TUPLE_UI_PATTERN],
        capture_output=True, text=True, timeout=2,
    )
    pids = [int(p) for p in result.stdout.split() if int(p) != os.getpid()]
    return pids[0] if pids else None


def toggle_mute():
    pid = find_tuple_ui_pid()
    if pid is None:
        log("Tuple UI is not running; can't toggle mute")
        sys.exit(1)
    os.kill(pid, TOGGLE_MUTE_SIGNAL)
    log(f"Sent toggle-mute signal to Tuple UI (pid {pid})")


if __name__ == "__main__":
    toggle_mute()
